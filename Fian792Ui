    local version=text(header,env.ChliseHubDisplayVersion or "",11,{
        Position=UDim2.fromOffset(220,18),Size=UDim2.fromOffset(66,23),
        BackgroundColor3=theme.Card,BackgroundTransparency=0,TextColor3=theme.Muted,
        TextXAlignment=Enum.TextXAlignment.Center})
    corner(version,6); outline(version)
    local minimize=button(header,"−",{BackgroundTransparency=1,
