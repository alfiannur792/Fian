    Main = Color3.fromRGB(8,13,28), Card = Color3.fromRGB(15,24,48),
    Line = Color3.fromRGB(28,48,92), Text = Color3.fromRGB(240,246,255),
    Muted = Color3.fromRGB(148,168,205), Accent = Color3.fromRGB(26,140,255),
    Selected = Color3.fromRGB(11,38,84), On = Color3.fromRGB(38,170,255)
}
local tabNames = {"PNB","Posisi","Penjaga","Auto Farm","Auto Rotation",
    "Visual Spoof","Grow Scan","World","Config","AFK & Return"}
local tabOrder = {}
for i,name in ipairs(tabNames) do tabOrder[name] = i end
local atlasData = ""
local logoData = ""
local function decode(data)
    local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local map = {}
    for i=1,#alphabet do map[alphabet:sub(i,i)] = i-1 end
    local bytes,acc,bits = {},0,0
    for i=1,#data do
        local value = map[data:sub(i,i)]
        if value then
            acc = acc*64+value
            bits += 6
            if bits >= 8 then
                bits -= 8
                bytes[#bytes+1] = string.char(math.floor(acc/2^bits)%256)
                acc %= 2^bits
            end
        end
    end
    return table.concat(bytes)
end
local images
local function assets()
    if images then return images end
    images = {}
    local asset = getcustomasset or getsynasset
    if type(asset) ~= "function" or type(writefile) ~= "function" then
        warn("[Fian792UI] Custom image API unavailable; using built-in fallback icons")
        return images
    end
    for name,data in pairs({Logo=logoData,Atlas=atlasData}) do
        local ok,result = pcall(function()
            local path = "fian792-ui-20261120-"..name..".png"
            if type(isfile) ~= "function" or not isfile(path) then
                writefile(path,decode(data))
            end
            return asset(path)
        end)
        if ok then images[name]=result else warn("[Fian792UI] Image:",result) end
    end
    return images
end
local function new(class,props,parent)
    local obj = Instance.new(class)
    for key,value in pairs(props or {}) do obj[key]=value end
    obj.Parent=parent
    return obj
end
local function corner(obj,radius)
    new("UICorner",{CornerRadius=UDim.new(0,radius or 8)},obj)
end
local function outline(obj)
    return new("UIStroke",{Color=theme.Line,Thickness=1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},obj)
end
local function text(parent,value,size,props)
    local defaults = {BackgroundTransparency=1,Text=tostring(value or ""),
        TextColor3=theme.Text,TextSize=size or 14,Font=Enum.Font.Gotham,
        TextXAlignment=Enum.TextXAlignment.Left,TextYAlignment=Enum.TextYAlignment.Center,
        BorderSizePixel=0,Size=UDim2.fromScale(1,1)}
    for key,val in pairs(props or {}) do defaults[key]=val end
    return new("TextLabel",defaults,parent)
end
local function button(parent,value,props)
    local defaults = {Text=tostring(value or ""),TextColor3=theme.Text,
        TextSize=14,Font=Enum.Font.GothamMedium,BackgroundColor3=theme.Card,
        BorderSizePixel=0,AutoButtonColor=true}
    for key,val in pairs(props or {}) do defaults[key]=val end
    return new("TextButton",defaults,parent)
end
local function list(parent,gap)
    return new("UIListLayout",{Padding=UDim.new(0,gap or 8),
        SortOrder=Enum.SortOrder.LayoutOrder},parent)
end
local function padding(parent,amount)
    new("UIPadding",{PaddingTop=UDim.new(0,amount),PaddingBottom=UDim.new(0,amount),
        PaddingLeft=UDim.new(0,amount),PaddingRight=UDim.new(0,amount)},parent)
end
local function callback(options,...)
    if type(options.Callback)=="function" then
        local ok,err = pcall(options.Callback,...)
        if not ok then warn("[Fian792UI] "..tostring(options.Title)..":",err) end
    end
end
local function logo(parent,size)
    local holder=new("Frame",{BackgroundTransparency=1,Size=UDim2.fromOffset(size,size)},parent)
    if assets().Logo then
        new("ImageLabel",{BackgroundTransparency=1,Image=images.Logo,
            Size=UDim2.fromScale(1,1),ScaleType=Enum.ScaleType.Fit},holder)
    else
        text(holder,"</>",size*0.6,{TextColor3=theme.Accent,Font=Enum.Font.GothamBold,
            TextXAlignment=Enum.TextXAlignment.Center})
    end
    return holder
end

function UI:CreateWindow(options)
