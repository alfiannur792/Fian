    local maximize=button(header,"□",{BackgroundTransparency=1,
        Position=UDim2.new(1,-84,0,8),Size=UDim2.fromOffset(36,40),TextSize=22})
    local close=button(header,"×",{BackgroundTransparency=1,
        Position=UDim2.new(1,-44,0,8),Size=UDim2.fromOffset(36,40),TextSize=25})
    new("Frame",{BorderSizePixel=0,BackgroundColor3=theme.Line,
        Position=UDim2.fromOffset(0,57),Size=UDim2.new(1,0,0,1)},main)
    local sidebar=new("ScrollingFrame",{Name="Sidebar",BackgroundTransparency=1,
        BorderSizePixel=0,Position=UDim2.fromOffset(0,58),Size=UDim2.new(0,204,1,-58),
        CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=3,
        ScrollBarImageColor3=theme.Accent},main)
    padding(sidebar,8);list(sidebar,3)
    local divider=new("Frame",{BorderSizePixel=0,BackgroundColor3=theme.Line,
        Position=UDim2.fromOffset(204,58),Size=UDim2.new(0,1,1,-58)},main)
    local content=new("Frame",{Name="Content",BackgroundTransparency=1,
        Position=UDim2.fromOffset(205,58),Size=UDim2.new(1,-205,1,-58)},main)
    local restore=button(gui,"",{Name="OpenChliseHub",BackgroundTransparency=1,
        Position=UDim2.fromOffset(18,110),Size=UDim2.fromOffset(56,56),Visible=false})
    restore.Parent=bounds
    local restoreMark=logo(restore,48);restoreMark.Position=UDim2.fromOffset(4,4)
    local resizeHandle=button(main,"",{Name="ResizeHandle",BackgroundTransparency=1,
        AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-2,1,-2),ZIndex=15})
    local gripLines={}
    for i=1,3 do
        gripLines[i]=new("Frame",{BorderSizePixel=0,BackgroundColor3=theme.Muted,
            AnchorPoint=Vector2.new(1,0.5),Rotation=-45,ZIndex=15},resizeHandle)
    end
    local requestedSize
    local restorePositioned=false
    local function viewport()
        return bounds.AbsoluteSize
    end
    local function fit()
        local screen=viewport()
        if screen.X<=24 or screen.Y<=24 then return end
        local maxW,maxH=screen.X-24,screen.Y-24
        local desired=requestedSize or Vector2.new(math.min(600,screen.X*0.7),math.min(390,screen.Y*0.7))
        local width=window.Expanded and maxW or math.clamp(desired.X,math.min(420,maxW),maxW)
        local height=window.Expanded and maxH or math.clamp(desired.Y,math.min(220,maxH),maxH)
        main.Size=UDim2.fromOffset(width,height)
        local sidebarWidth=math.clamp(width*0.28,128,184)
        sidebar.Size=UDim2.new(0,sidebarWidth,1,-58)
        divider.Position=UDim2.fromOffset(sidebarWidth,58)
        content.Position=UDim2.fromOffset(sidebarWidth+1,58)
        content.Size=UDim2.new(1,-sidebarWidth-1,1,-58)
        local compact=width<440
        heading.TextSize=compact and 18 or 22
        heading.Position=UDim2.fromOffset(compact and 58 or 64,compact and 6 or 0)
        heading.Size=UDim2.fromOffset(compact and 116 or 148,compact and 25 or 58)
        version.Position=compact and UDim2.fromOffset(58,33) or UDim2.fromOffset(220,18)
        version.Size=UDim2.fromOffset(66,compact and 18 or 23)
        resizeHandle.Size=UDim2.fromOffset(32,32)
        for i,line in ipairs(gripLines) do
            line.Size=UDim2.fromOffset(4+i*3,1)
            line.Position=UDim2.new(1,-6,1,-(3+i*4))
        end
        local halfW,halfH=width/2,height/2
        local x=main.Position.X.Scale*screen.X+main.Position.X.Offset
        local y=main.Position.Y.Scale*screen.Y+main.Position.Y.Offset
        main.Position=UDim2.fromOffset(math.clamp(x,halfW+8,math.max(halfW+8,screen.X-halfW-8)),
            math.clamp(y,halfH+8,math.max(halfH+8,screen.Y-halfH-8)))
        if not restorePositioned then
            restore.Position=UDim2.fromOffset((screen.X-56)/2,math.max(0,screen.Y*0.18-28))
            restorePositioned=true
        end
        restore.Position=UDim2.fromOffset(math.clamp(restore.Position.X.Offset,0,math.max(0,screen.X-56)),
            math.clamp(restore.Position.Y.Offset,0,math.max(0,screen.Y-56)))
    end
    connect(bounds:GetPropertyChangedSignal("AbsoluteSize"),fit)
    fit()
    local resizePointer,resizeStart,resizeSize,resizePosition
    connect(resizeHandle.InputBegan,function(input)
        if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
        resizePointer=input;resizeStart=input.Position
        resizeSize=Vector2.new(main.Size.X.Offset,main.Size.Y.Offset);resizePosition=main.Position
        window.Expanded=false
    end)
    connect(Input.InputChanged,function(input)
        if not resizePointer then return end
        if resizePointer.UserInputType==Enum.UserInputType.Touch and input~=resizePointer then return end
        if resizePointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
        local delta=input.Position-resizeStart
        local screen=viewport()
        local maxW,maxH=screen.X-24,screen.Y-24
        if maxW<=0 or maxH<=0 then return end
        requestedSize=Vector2.new(math.clamp(resizeSize.X+delta.X,math.min(420,maxW),maxW),
            math.clamp(resizeSize.Y+delta.Y,math.min(220,maxH),maxH))
        main.Position=UDim2.fromOffset(resizePosition.X.Offset+(requestedSize.X-resizeSize.X)/2,
            resizePosition.Y.Offset+(requestedSize.Y-resizeSize.Y)/2)
        fit()
    end)
    connect(Input.InputEnded,function(input) if input==resizePointer then resizePointer=nil end end)
    connect(Input.WindowFocusReleased,function() resizePointer=nil end)
    local function drag(handle,target,activated)
        local start,origin,pointer,moved
        connect(handle.InputBegan,function(input)
            if input.UserInputType~=Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.Touch then return end
            start=input.Position;origin=target.Position;pointer=input;moved=false
        end)
        connect(Input.InputChanged,function(input)
            if not pointer then return end
            if pointer.UserInputType==Enum.UserInputType.Touch and input~=pointer then return end
            if pointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType~=Enum.UserInputType.MouseMovement then return end
            local delta=input.Position-start
            if delta.Magnitude>5 then moved=true end
            target.Position=UDim2.new(origin.X.Scale,origin.X.Offset+delta.X,
                origin.Y.Scale,origin.Y.Offset+delta.Y)
        end)
        connect(Input.InputEnded,function(input)
            if input~=pointer then return end
            pointer=nil;fit()
            if activated and not moved then activated() end
        end)
    end
    header.Active=true
    drag(header,main)
    function window:Open() main.Visible=true;restore.Visible=false end
    function window:Close() main.Visible=false;restore.Visible=true end
    function window:OnClose(handler) self.CloseHandler=handler end
    local closeDialog
    function window:RequestClose()
        if closeDialog then return end
        local overlay=new("Frame",{Name="CloseConfirmation",Size=UDim2.fromScale(1,1),
            BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.25,ZIndex=30},main)
        closeDialog=overlay
        button(overlay,"",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),ZIndex=30})
        local dialog=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),
            Size=UDim2.new(1,-24,1,-24),BackgroundColor3=theme.Main,BorderSizePixel=0,ZIndex=31},overlay)
        new("UISizeConstraint",{MaxSize=Vector2.new(380,190)},dialog)
        corner(dialog,10);outline(dialog)
        text(dialog,"Close Fian792 UI?",16,{Position=UDim2.fromOffset(16,12),
            Size=UDim2.new(1,-32,0,26),Font=Enum.Font.GothamBold,ZIndex=32})
        local message=text(dialog,"Stop all running Fian792 UI features and close the UI?",13,{
            Position=UDim2.fromOffset(16,45),Size=UDim2.new(1,-32,1,-111),
            TextWrapped=true,TextColor3=theme.Muted,ZIndex=32})
        local cancel=button(dialog,"Cancel",{Position=UDim2.new(0,16,1,-54),
            Size=UDim2.new(0.5,-22,0,38),ZIndex=32})
        local confirm=button(dialog,"Stop & Close",{Position=UDim2.new(0.5,6,1,-54),
            Size=UDim2.new(0.5,-22,0,38),BackgroundColor3=theme.Accent,ZIndex=32})
        corner(cancel,6);corner(confirm,6)
        cancel.Activated:Connect(function()
            if self.Closing then return end
            overlay:Destroy();closeDialog=nil
        end)
        confirm.Activated:Connect(function()
            if self.Closing then return end
            if not self.CloseHandler then message.Text="Fian792 UI is still loading. Try again shortly.";return end
            self.Closing=true
            message.Text="Stopping Fian792 UI..."
            local ok,err=pcall(self.CloseHandler)
            if not ok then
                self.Closing=false
                message.Text="Could not finish stopping. Try Stop & Close again."
                warn("[Fian792UI] Shutdown:",err)
                return
            end
            self:Destroy()
        end)
    end
    function window:EditOpenButton(config)
        restore.Visible=not main.Visible and config.Enabled~=false
    end
    connect(minimize.Activated,function() window:Close() end)
    connect(close.Activated,function() window:RequestClose() end)
    connect(maximize.Activated,function() window.Expanded=not window.Expanded;fit() end)
    drag(restore,restore,function() window:Open() end)
    function window:Destroy() gui:Destroy() end
    connect(gui.Destroying,function()
        for _,connection in ipairs(connections) do connection:Disconnect() end
        table.clear(connections)
    end)
    function window:Tab(config)
        local title=config.Title
        if self.Tabs[title] then return self.Tabs[title] end
        local index=tabOrder[title]
        local row=button(sidebar,"",{Size=UDim2.new(1,0,0,40),
            LayoutOrder=index or 100,BackgroundTransparency=1})
        corner(row,7)
        local accent=new("Frame",{BorderSizePixel=0,BackgroundColor3=theme.Accent,
            Size=UDim2.fromOffset(3,28),Position=UDim2.fromOffset(0,6),Visible=false},row)
        if index and assets().Atlas then
            new("ImageLabel",{BackgroundTransparency=1,Image=images.Atlas,
                ImageRectOffset=Vector2.new(((index-1)%5)*48,math.floor((index-1)/5)*48),
                ImageRectSize=Vector2.new(48,48),Position=UDim2.fromOffset(10,7),
                Size=UDim2.fromOffset(26,26)},row)
        else
            text(row,index and tostring(index) or "!",14,{Position=UDim2.fromOffset(10,0),Size=UDim2.fromOffset(26,40),TextColor3=theme.Accent})
        end
        text(row,title,14,{Position=UDim2.fromOffset(43,0),Size=UDim2.new(1,-46,1,0),Font=Enum.Font.GothamMedium,TextWrapped=true})
        local page=new("ScrollingFrame",{BackgroundTransparency=1,BorderSizePixel=0,
            Size=UDim2.fromScale(1,1),CanvasSize=UDim2.new(),AutomaticCanvasSize=Enum.AutomaticSize.Y,
            ScrollBarThickness=4,ScrollBarImageColor3=theme.Accent,Visible=false},content)
        padding(page,14);list(page,10)
        local tab={Page=page,Row=row}
        function tab:Select()
            for _,other in pairs(window.Tabs) do
                other.Page.Visible=false;other.Row.BackgroundTransparency=1;other.Accent.Visible=false
            end
            page.Visible=true;row.BackgroundTransparency=0;row.BackgroundColor3=theme.Selected;accent.Visible=true
        end
        tab.Accent=accent
        connect(row.Activated,function() tab:Select() end)
        function tab:Section(config)
            local frame=new("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),
                AutomaticSize=Enum.AutomaticSize.Y},page)
            list(frame,8)
            local titleButton=button(frame,config.Title or "",{LayoutOrder=0,Size=UDim2.new(1,0,0,38),
                TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.GothamBold})
            padding(titleButton,12);corner(titleButton,8)
            local caret=new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),
                Position=UDim2.new(1,-18,0.5,0),Size=UDim2.fromOffset(12,12),
                BackgroundTransparency=1,Rotation=config.Opened~=false and 90 or 0},titleButton)
            for _,side in ipairs({-1,1}) do
                new("Frame",{AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromOffset(6,6+side*2.5),
                    Size=UDim2.fromOffset(7,2),Rotation=-side*45,BorderSizePixel=0,
                    BackgroundColor3=theme.Muted},caret)
            end
            local body=new("Frame",{LayoutOrder=1,BackgroundTransparency=1,Size=UDim2.new(1,0,0,0),
                AutomaticSize=Enum.AutomaticSize.Y,Visible=config.Opened~=false},frame)
            list(body,8)
            connect(titleButton.Activated,function() body.Visible=not body.Visible;caret.Rotation=body.Visible and 90 or 0 end)
            local section={}
            local function card(config,right)
                local row=new("Frame",{BackgroundColor3=theme.Card,BorderSizePixel=0,Size=UDim2.new(1,0,0,64)},body)
                corner(row,8)
                local stroke=outline(row)
                local title=text(row,config.Title,14,{Position=UDim2.fromOffset(13,11),Font=Enum.Font.GothamMedium,
                    Size=UDim2.new(1,-26-(right or 0),0,18),TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Top})
                local desc=text(row,config.Desc,12,{Position=UDim2.fromOffset(13,32),TextColor3=theme.Muted,
                    Size=UDim2.new(1,-26-(right or 0),0,18),TextWrapped=true,TextYAlignment=Enum.TextYAlignment.Top})
                local area
                if right and right>90 then
                    area=new("Frame",{BackgroundTransparency=1},row)
                end
                local function measure()
                    local stacked=area and row.AbsoluteSize.X<430
                    local reserved=stacked and 0 or (right or 0)
                    local width=math.max(24,row.AbsoluteSize.X-26-reserved)
                    local titleH=math.max(18,TextService:GetTextSize(title.Text,14,title.Font,Vector2.new(width,10000)).Y)
                    local descH=desc.Text~="" and TextService:GetTextSize(desc.Text,12,desc.Font,Vector2.new(width,10000)).Y or 0
                    title.Size=UDim2.new(1,-26-reserved,0,titleH)
                    desc.Position=UDim2.fromOffset(13,13+titleH+4)
                    desc.Size=UDim2.new(1,-26-reserved,0,descH)
                    local height=26+titleH+(descH>0 and descH+4 or 0)
                    if area then
                        area.AnchorPoint=stacked and Vector2.new(0,0) or Vector2.new(1,0.5)
                        area.Position=stacked and UDim2.fromOffset(13,height-2) or UDim2.new(1,-13,0.5,0)
                        area.Size=stacked and UDim2.new(1,-26,0,36) or UDim2.fromOffset(right-20,36)
                        if stacked then height+=46 end
                    end
                    row.Size=UDim2.new(1,0,0,math.max(54,height))
                end
                connect(row:GetPropertyChangedSignal("AbsoluteSize"),measure)
                local control={Frame=row,Area=area}
                function control:SetDesc(value) desc.Text=tostring(value or "");measure() end
                function control:SetTitle(value) title.Text=tostring(value or "");measure() end
                function control:Destroy() row:Destroy() end
                measure()
                return control,row,stroke
            end
            function section:Paragraph(config) return (card(config)) end
            function section:Button(config)
                local control,row,stroke=card(config,32)
                text(row,"›",24,{Position=UDim2.new(1,-35,0,0),Size=UDim2.new(0,26,1,0),TextColor3=theme.Muted})
                local hit=button(row,"",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1)})
                local clickCount=0
                connect(hit.Activated,function()
                    clickCount+=1
                    local click=clickCount
                    row.BackgroundColor3=theme.Selected
                    stroke.Color=theme.Accent
                    task.delay(0.18,function()
                        if click~=clickCount or not row.Parent then return end
                        row.BackgroundColor3=theme.Card
                        stroke.Color=theme.Line
                    end)
                    callback(config)
                end)
                return control
            end
            function section:Toggle(config)
                local control,row=card(config,70)
                local track=button(row,"",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,-13,0.5,0),Size=UDim2.fromOffset(44,24)})
                corner(track,12)
                local dot=new("Frame",{BorderSizePixel=0,BackgroundColor3=theme.Text,Size=UDim2.fromOffset(18,18)},track)
                corner(dot,9)
                local value=config.Value==true
                local function render() track.BackgroundColor3=value and theme.On or theme.Line;dot.Position=UDim2.fromOffset(value and 23 or 3,3) end
                function control:Set(nextValue,emit)
                    value=nextValue==true;self.Value=value;render()
                    if emit~=false then callback(config,value) end
                end
                connect(track.Activated,function() control:Set(not value) end)
                control.Value=value;render()
                return control
            end
            function section:Input(config)
                local control,row=card(config,190)
                local field=new("TextBox",{Text=tostring(config.Value or ""),PlaceholderText=config.Placeholder or "",
                    ClearTextOnFocus=false,TextColor3=theme.Text,PlaceholderColor3=theme.Muted,TextSize=13,Font=Enum.Font.Gotham,
                    BackgroundColor3=theme.Main,BorderSizePixel=0,AnchorPoint=Vector2.new(1,0.5),
                    Position=UDim2.new(1,0,0.5,0),Size=UDim2.new(1,0,0,32)},control.Area)
                corner(field,6);outline(field);padding(field,7)
                function control:Set(value) field.Text=tostring(value or "");callback(config,field.Text) end
                connect(field.FocusLost,function() callback(config,field.Text) end)
                return control
            end
            function section:Slider(config)
                local control,row=card(config,200)
                local range=config.Value
                local minimum,maximum=range.Min,range.Max
                local step=config.Step or 1
                local field=new("TextBox",{Text="",ClearTextOnFocus=false,TextColor3=theme.Text,TextSize=12,Font=Enum.Font.Gotham,
                    BackgroundColor3=theme.Main,BorderSizePixel=0,Position=UDim2.new(1,-52,0.5,-13),Size=UDim2.fromOffset(52,26)},control.Area)
                corner(field,5)
                local track=button(control.Area,"",{Position=UDim2.new(0,0,0.5,-3),Size=UDim2.new(1,-68,0,6),BackgroundColor3=theme.Line})
                corner(track,3)
                local fill=new("Frame",{BorderSizePixel=0,BackgroundColor3=theme.Accent,Size=UDim2.fromScale(0,1)},track)
                corner(fill,3)
                local value=minimum
                function control:Set(inputValue,silent)
                    local number=tonumber(inputValue)
                    if not number or number~=number then field.Text=tostring(value);return end
                    value=math.clamp(minimum+math.floor((number-minimum)/step+0.5)*step,minimum,maximum)
                    self.Value=value;field.Text=tostring(value)
                    fill.Size=UDim2.fromScale(maximum>minimum and (value-minimum)/(maximum-minimum) or 0,1)
                    if not silent then callback(config,value) end
                end
                local pointer
                local function update(input)
                    local ratio=math.clamp((input.Position.X-track.AbsolutePosition.X)/math.max(1,track.AbsoluteSize.X),0,1)
                    control:Set(minimum+ratio*(maximum-minimum))
                end
                local hit=button(control.Area,"",{BackgroundTransparency=1,Position=UDim2.new(0,-6,0.5,-18),Size=UDim2.new(1,-62,0,36)})
                connect(hit.InputBegan,function(input)
                    if input.UserInputType==Enum.UserInputType.Touch or input.UserInputType==Enum.UserInputType.MouseButton1 then pointer=input;update(input) end
                end)
                connect(Input.InputChanged,function(input)
                    if pointer and (input==pointer or (pointer.UserInputType==Enum.UserInputType.MouseButton1 and input.UserInputType==Enum.UserInputType.MouseMovement)) then update(input) end
                end)
                connect(Input.InputEnded,function(input) if input==pointer then pointer=nil end end)
                connect(field.FocusLost,function() control:Set(field.Text) end)
                control:Set(range.Default or minimum,true)
                return control
            end
            function section:Dropdown(config)
                local control,row=card(config,190)
                control.Values=config.Values or {}
                local chosen=config.Multi and {} or config.Value
                if config.Multi then
                    for key,value in pairs(type(config.Value)=="table" and config.Value or {}) do
                        chosen[type(key)=="number" and value or key]=type(key)=="number" or value==true
                    end
                end
                local selectButton=button(control.Area,"",{AnchorPoint=Vector2.new(1,0.5),Position=UDim2.new(1,0,0.5,0),Size=UDim2.new(1,0,0,32),TextTruncate=Enum.TextTruncate.AtEnd})
                corner(selectButton,6);outline(selectButton);padding(selectButton,7)
                local function render()
                    if config.Multi then
                        local labels={}
                        for _,value in ipairs(control.Values) do if chosen[value] then labels[#labels+1]=tostring(value) end end
                        selectButton.Text=#labels>0 and table.concat(labels,", ") or "—"
                    else selectButton.Text=tostring(chosen or "—") end
                    control.Value=chosen
                end
                local function notify()
                    if config.Multi then
                        local result={}
                        for _,value in ipairs(control.Values) do if chosen[value] then result[#result+1]=value end end
                        callback(config,result)
                    else callback(config,chosen) end
                end
                function control:Select(value)
                    if config.Multi then
                        chosen={}
                        for key,val in pairs(type(value)=="table" and value or {}) do
                            chosen[type(key)=="number" and val or key]=type(key)=="number" or val==true
                        end
                    else chosen=value end
                    render()
                end
                control.Set=control.Select
                local rebuild
                function control:Refresh(values)
                    self.Values=values.Values or values
                    if values.Values and values.Value~=nil then self:Select(values.Value) end
                    render()
                    if rebuild then rebuild() end
                end
                local modal
                local function dismiss() if modal then modal:Destroy();modal=nil;rebuild=nil end end
                connect(selectButton.Activated,function()
                    if modal then dismiss();return end
                    modal=new("Frame",{Name="DropdownOverlay",Size=UDim2.fromScale(1,1),BackgroundTransparency=1,ZIndex=20},main)
                    local backdrop=button(modal,"",{Size=UDim2.fromScale(1,1),BackgroundColor3=Color3.new(0,0,0),BackgroundTransparency=0.25,ZIndex=20})
                    local dialog=new("Frame",{Size=UDim2.new(1,-24,1,-24),AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.fromScale(0.5,0.5),BackgroundColor3=theme.Main,BorderSizePixel=0,ZIndex=21},modal)
                    new("UISizeConstraint",{MaxSize=Vector2.new(440,350)},dialog)
                    corner(dialog,10);outline(dialog)
                    text(dialog,config.Title,16,{Position=UDim2.fromOffset(14,10),Size=UDim2.new(1,-70,0,28),ZIndex=22,Font=Enum.Font.GothamBold})
                    local done=button(dialog,"×",{Position=UDim2.new(1,-44,0,6),Size=UDim2.fromOffset(36,36),ZIndex=22,BackgroundTransparency=1,TextSize=24})
                    local search=new("TextBox",{Text="",PlaceholderText="Search…",ClearTextOnFocus=false,
                        TextColor3=theme.Text,PlaceholderColor3=theme.Muted,TextSize=14,Font=Enum.Font.Gotham,
                        BackgroundColor3=theme.Card,BorderSizePixel=0,Position=UDim2.fromOffset(14,48),Size=UDim2.new(1,-28,0,34),ZIndex=22},dialog)
                    corner(search,6);padding(search,8)
                    local choices=new("ScrollingFrame",{BackgroundTransparency=1,BorderSizePixel=0,
                        Position=UDim2.fromOffset(14,92),Size=UDim2.new(1,-28,1,-106),CanvasSize=UDim2.new(),
                        AutomaticCanvasSize=Enum.AutomaticSize.Y,ScrollBarThickness=4,ScrollBarImageColor3=theme.Accent,ZIndex=22},dialog)
                    list(choices,4)
                    rebuild=function()
                        for _,child in ipairs(choices:GetChildren()) do if child:IsA("GuiObject") then child:Destroy() end end
                        local query=search.Text:lower()
                        for _,value in ipairs(control.Values) do
                            if tostring(value):lower():find(query,1,true) then
                                local selected=config.Multi and chosen[value] or chosen==value
                                local option=button(choices,(selected and "✓  " or "")..tostring(value),{Size=UDim2.new(1,-5,0,34),ZIndex=23,BackgroundColor3=selected and theme.Selected or theme.Card,TextXAlignment=Enum.TextXAlignment.Left,TextTruncate=Enum.TextTruncate.AtEnd})
                                corner(option,5);padding(option,9)
                                option.Activated:Connect(function()
                                    if config.Multi then
                                        local count=0
                                        for _,enabled in pairs(chosen) do if enabled then count+=1 end end
                                        if chosen[value] and count==1 and config.AllowNone~=true then return end
                                        chosen[value]=not chosen[value];render();notify()
                                        if rebuild then rebuild() end
                                    else control:Select(value);notify();dismiss() end
                                end)
                            end
                        end
                    end
                    backdrop.Activated:Connect(dismiss);done.Activated:Connect(dismiss)
                    search:GetPropertyChangedSignal("Text"):Connect(rebuild)
                    rebuild()
                end)
                render()
                return control
            end
            return section
        end
        self.Tabs[title]=tab
        if not self.Selected then self.Selected=title;tab:Select() end
        return tab
    end
    UI.LastWindow=window
    return window
end

function UI:StyleGridPopup(frame)
    if frame:GetAttribute("Fian792GridStyled") then return end
    frame:SetAttribute("Fian792GridStyled",true)
    frame.BackgroundColor3=theme.Main
    local border=frame:FindFirstChildOfClass("UIStroke")
    if border then border.Color=theme.Line end
    for _,child in ipairs(frame:GetChildren()) do
        if child:IsA("TextLabel") then
            child.TextColor3=theme.Muted
            child.Text=child.Text:gsub("C = karakter","P = karakter")
            if child.Text:find("GRID",1,true) or child.Text:find("PRIORITY",1,true) then
                child.TextColor3=theme.Text
                child.TextSize=14
                child.TextWrapped=true
                child.TextXAlignment=Enum.TextXAlignment.Left
                child.Position=UDim2.fromOffset(48,9)
                child.Size=UDim2.new(1,-60,0,30)
            end
        elseif child:IsA("TextButton") then
            child.BackgroundColor3=child.Text=="SELESAI" and theme.Accent or theme.Card
            child.TextColor3=theme.Text
            child.TextSize=13
            if not child:FindFirstChildOfClass("UIStroke") then outline(child) end
        elseif child:IsA("Frame") then
            for _,tile in ipairs(child:GetChildren()) do
                if tile:IsA("TextButton") then
                    local stroke=tile:FindFirstChildOfClass("UIStroke")
                        or new("UIStroke",{Thickness=1,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},tile)
                    tile.TextSize=18
                    local applying=false
                    local function render()
                        if applying then return end
                        applying=true
                        local value=tile.Text
                        local center=value=="C" or value=="P" or value:match(" P$")~=nil
                        local selected=value=="X" or value:match("^%d+")~=nil
                        if value=="C" then tile.Text="P" end
                        if value=="-" then tile.Text="·" end
                        tile.BackgroundColor3=selected and theme.Selected or theme.Card
                        tile.TextColor3=center and theme.Accent or (selected and theme.Text or theme.Muted)
                        stroke.Color=(selected or center) and theme.Accent or theme.Line
                        applying=false
                    end
                    tile:GetPropertyChangedSignal("Text"):Connect(render)
                    tile:GetPropertyChangedSignal("BackgroundColor3"):Connect(render)
                    render()
                end
            end
        end
    end
    local mark=logo(frame,26)
    mark.Name="Fian792GridLogo"
    mark.Position=UDim2.fromOffset(13,10)
    mark.ZIndex=frame.ZIndex+2
    for _,part in ipairs(mark:GetChildren()) do
        if part:IsA("GuiObject") then part.ZIndex=mark.ZIndex end
    end
end

function UI:Notify(options)
    local window=self.LastWindow
    if not window or not window.Gui.Parent then return end
    local toast=new("Frame",{AnchorPoint=Vector2.new(1,1),Position=UDim2.new(1,-16,1,-16),
        Size=UDim2.fromOffset(280,90),BackgroundColor3=theme.Card,BorderSizePixel=0,ZIndex=50},window.Gui)
    corner(toast,9);outline(toast)
    text(toast,options.Title,14,{Position=UDim2.fromOffset(12,9),Size=UDim2.new(1,-24,0,20),ZIndex=51,Font=Enum.Font.GothamBold})
    text(toast,options.Content,12,{Position=UDim2.fromOffset(12,33),Size=UDim2.new(1,-24,1,-40),TextWrapped=true,TextColor3=theme.Muted,ZIndex=51})
    task.delay(options.Duration or 4,function() if toast.Parent then toast:Destroy() end end)
end

return UI
